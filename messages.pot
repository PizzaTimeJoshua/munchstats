#: templates/about.html:180
msgid "How often does the replay data get updated?"
msgstr ""

#: templates/about.html:181
msgid "Every 12 hours automatically."
msgstr ""

#: templates/about.html:184
msgid "Can you show replays from over a month ago?"
msgstr ""

#: templates/about.html:185
msgid ""
"No. Due to memory constraints, only the last month of replays is "
"available."
msgstr ""

